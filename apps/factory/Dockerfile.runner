# syntax=docker/dockerfile:1
#
# Imagen del WORKER de la Fábrica (apps/factory, D-047 — incremento C de Fase 2).
# Consume `analysis_jobs` y corre el Agent SDK headless: es el único proceso con
# checkout del monorepo (`PLATFORM_REPO_PATH`) y `ANTHROPIC_API_KEY`. La imagen
# del control plane (apps/factory/Dockerfile) sigue SIN ninguna de las dos —
# quien sirve OAuth/HTTP no ejecuta agentes (D-030 sigue en pie).
#
# Por qué un Dockerfile aparte y no un stage más del otro:
#  1. **Base distinta**. El resto del stack es node:22-alpine (musl). El Agent
#     SDK trae binarios (ripgrep y compañía) empaquetados para glibc, así que
#     este va sobre Debian slim. Mezclar stages entre bases distintas rompería
#     los prebuilds nativos que `pnpm deploy` copia (p. ej. @node-rs/argon2).
#  2. **Lección D-016**: añadir stages al final de un Dockerfile existente pisa
#     el stage por defecto de quien no declare `target:`. Archivo aparte, cero
#     riesgo sobre las imágenes que ya funcionan.
#
# Build context: raíz del monorepo (resuelve @awk/types y @awk/auth).

FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/factory/package.json apps/factory/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY turbo.json tsconfig.base.json ./
COPY packages/types packages/types
COPY packages/auth packages/auth
COPY apps/factory apps/factory
# "pnpm exec turbo", nunca "pnpm turbo" (ver STATUS: el atajo reinstala en
# modo --production a mitad de la corrida).
RUN pnpm exec turbo run build --filter=...@awk/factory
RUN pnpm --filter=@awk/factory deploy --prod --legacy /out/factory

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
# git: el worker pone al día su checkout antes de cada análisis (fetch + reset,
# solo si FACTORY_WORKER_GIT_SYNC=1). ca-certificates: HTTPS a la API y a GitHub.
#
# openssh-client NO es opcional aunque lo parezca: el remoto del repo es
# `git@github.com:...` y git invoca el binario `ssh` para hablar con él. En
# Debian, `git` solo lo RECOMIENDA, y `--no-install-recommends` lo deja fuera —
# el primer deploy real (2026-08-16) falló justo así: `git fetch` no arrancaba y
# el worker analizaba con un checkout que nunca se actualizaba.
#
# curl/gnupg: solo para instalar `gh` desde su repositorio oficial (abajo).
RUN apt-get update \
  && apt-get install -y --no-install-recommends git openssh-client ca-certificates curl gnupg \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI: lo usa el worker de GENERACIÓN (D3) para abrir la PR, esperar los
# checks y mergear. Va en ESTA imagen (no en una aparte) porque los dos workers
# comparten imagen y se diferencian solo por FACTORY_WORKER_KINDS; en el
# contenedor de análisis simplemente no se invoca.
#
# Desde el repo apt oficial y no pinneando un .deb concreto a propósito: una
# versión fija se queda vieja y, peor, un tag inexistente rompe el build de una
# imagen que no tiene nada que ver con el cambio que lo destapó.
RUN mkdir -p -m 755 /etc/apt/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# pnpm en el RUNTIME (no solo en el build): el agente de generación corre
# `pnpm exec turbo run build lint typecheck test` dentro del checkout montado.
# Se "prepara" la versión exacta del monorepo en tiempo de build para que
# corepack no tenga que descargarla en mitad del primer run —un fallo de red ahí
# tumbaría una generación de 25 minutos por no tener el gestor de paquetes.
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate
WORKDIR /app
COPY --from=build /out/factory ./
# El checkout del monorepo NO va dentro de la imagen: se monta como volumen
# desde el host (/opt/awkfactory/<entorno>/platform-repo → /platform-repo).
# Sin puerto: el worker no escucha nada, solo habla con la BD y con la API.
CMD ["node", "dist/worker.js"]
