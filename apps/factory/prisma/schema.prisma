// Modelo de datos de la Fábrica (awkfactory, docs/03-arquitectura.md).
// Sistema SEPARADO de la Plataforma (apps/api/prisma/schema.prisma): otra
// base de datos lógica en la MISMA instancia Postgres managed (D-029), sin
// esquemas ni tablas compartidas con `core`/`moodle`/`orientador`.
//
// Entidades (docs/04-integracion-cowork.md, pasos 2-6 del pipeline):
// Project (un prototipo/encargo en curso por la fábrica), Spec (spec
// funcional+técnica de una versión concreta), Gate (aprobación humana sobre
// una spec — funcional, técnica, de PR o de aceptación del gerente) y Run
// (una ejecución del Agent SDK: análisis o generación).
//
// Generador: mismo patrón que apps/api (D-010) — `prisma-client` sin engines
// Rust, cliente TS en src/generated/prisma (gitignored), driver adapter
// @prisma/adapter-pg en runtime.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Estado del proyecto en el pipeline (docs/03-arquitectura.md, "Estados del
/// proyecto"). Único campo que mueve el runner/CLI; nunca se edita a mano.
enum ProjectStatus {
  received // INTAKE: proyecto creado, aún no se corrió ningún análisis
  analyzing // Run de análisis en curso
  spec_ready // Spec generada (versión N), gates recién abiertos
  pending_approval // Esperando decisión de uno o ambos gates (funcional/técnica)
  generating // Run de generación en curso (Agent SDK escribiendo código)
  verifying // Rama/PR generados; build/lint/test corriendo o ya corrido
  pr_review // PR abierta, esperando revisión humana (docs/05)
  staging // PR mergeada y desplegada a staging, esperando validación del gerente
  manager_acceptance // Gerente validando en staging
  deployed // Promovido a producción — estado terminal de éxito
  changes_requested // Gate de PR o de aceptación pidió cambios — vuelve a generating
  rejected // Gate funcional/técnico rechazó el proyecto — terminal
  error // Un run falló y no quedó en un estado recuperable sin intervención

  @@map("project_status")
}

enum ProjectSourceType {
  manual // Aportado directamente por Leonardo (Fase 1, sin Cowork todavía)
  cowork_prototype // Entrada vía conector MCP submit_prototype (Fase 2, docs/04)

  @@map("project_source_type")
}

/// Un prototipo/encargo que atraviesa el pipeline. `moduleSlug` es el nombre
/// final de carpeta en la Plataforma (apps/api/src/modules/<slug>,
/// apps/web/src/modules/<slug>) — se fija en la creación porque el gate y la
/// generación ya lo necesitan como convención de rutas.
model Project {
  id          String            @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  moduleSlug  String            @unique
  displayName String
  sourceType  ProjectSourceType @default(manual)
  /// Ruta o descripción del material fuente (carpeta del prototipo, texto
  /// libre). No es un contrato tipado todavía — eso es la skill de
  /// prototipado de Fase 2 (docs/04, prototype.manifest.json).
  sourceRef   String
  requestedBy String
  status      ProjectStatus     @default(received)

  specs          Spec[]
  runs           Run[]
  changeRequests ChangeRequest[]
  submissions    PrototypeSubmission[]
  analysisJobs   AnalysisJob[]

  @@map("projects")
}

/// Rol de un actor de la Fábrica (auth interina PAT, D-036). `gerente` opera
/// desde Cowork (submit/status/request_change + gates functional y
/// manager_acceptance de SUS proyectos); `admin` es Leonardo (todo).
enum FactoryActorRole {
  gerente
  admin

  @@map("factory_actor_role")
}

/// Actor autenticable por PAT (D-036, auth interina hasta que exista el SSO).
/// Sin FK a core.users (D-029/D-030: se comparte contrato, no BD). El token
/// se emite por CLI (`create-actor`), se muestra UNA vez y aquí solo vive su
/// hash SHA-256. Revocar = poner `revokedAt` (no se borra la fila: auditoría).
/// `email` NO es único: reemitir un token para el mismo gerente crea una fila
/// nueva y revoca las anteriores.
model FactoryActor {
  id        String           @id @default(uuid(7)) @db.Uuid
  createdAt DateTime         @default(now())
  email     String
  role      FactoryActorRole
  tokenHash String           @unique
  revokedAt DateTime?
  /// Hash argon2id de la contraseña de login del Authorization Server propio
  /// (docs/08, D-041). NULL = actor solo-PAT (técnico por CLI) que no hace
  /// login OAuth. Se setea por CLI (`set-password`); el hash, nunca la clave.
  passwordHash String?

  @@index([email])
  @@map("factory_actors")
}

/// Almacén único del adapter de node-oidc-provider (docs/08, D-041). Persiste
/// TODOS los tipos de modelo de la librería (Session, Grant, AccessToken,
/// RefreshToken, AuthorizationCode, Interaction, ReplayDetection, ...) en una
/// tabla, discriminados por `model`. El `payload` es un JSONB opaco cuya forma
/// la define la librería — por eso no se modela campo a campo. Las columnas
/// auxiliares soportan los find-by del contrato del adapter (grantId, userCode,
/// uid) y el single-use (`consumedAt`) sin parsear el payload.
model OauthModel {
  model     String
  id        String
  payload   Json
  grantId   String?
  userCode  String?
  uid       String?
  expiresAt DateTime?
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@id([model, id])
  @@index([grantId])
  @@index([userCode])
  @@index([uid])
  @@index([expiresAt])
  @@map("oauth_models")
}

/// Un prototipo enviado desde Cowork vía `submit_prototype` (D-036): la
/// fuente HTML completa + el prototype.manifest.json validado (docs/04,
/// paso 1) viven en BD — el CLI `analyze` los materializa a disco al correr
/// el análisis (reemplaza el `--source-ref` manual para proyectos
/// `cowork_prototype`). `submittedBy` = email del actor del PAT.
model PrototypeSubmission {
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now())
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// prototype.manifest.json ya validado con prototypeManifestSchema (@awk/types).
  manifest    Json
  /// HTML autocontenido del prototipo, tal como llegó de Cowork.
  source      String   @db.Text
  submittedBy String

  @@index([projectId])
  @@map("prototype_submissions")
}

/// Una petición de cambio sobre un módulo YA generado/desplegado
/// (request_change, docs/04-integracion-cowork.md, paso "Mantenimiento").
/// Modelo LIGERO (decisión 2026-07-19): NO tiene máquina de estados propia —
/// reutiliza el pipeline existente sobre el MISMO Project (una iteración
/// activa por módulo en Fase 1). Guarda el texto de la petición y quién la
/// pidió (docs/05: "firmado por persona") y enlaza la(s) mini-spec(s) que el
/// análisis de cambio produce. `Project.status` sigue siendo el único tracker
/// del pipeline: refleja la ITERACIÓN en curso, no la salud de lo que ya está
/// vivo en producción (que no se toca hasta mergear+promover).
model ChangeRequest {
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now())
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Email/nombre de quien pide el cambio. Sin FK a core.users (D-029: la
  /// Fábrica no comparte BD con la Plataforma).
  requestedBy String
  /// Texto libre de la observación/petición del gerente. En Fase 2 llegará
  /// tipado por el MCP `request_change` (docs/04); en Fase 1 es texto plano.
  requestText String   @db.Text

  specs        Spec[]
  analysisJobs AnalysisJob[]

  @@map("change_requests")
}

/// Tipo de trabajo encolado (D-047, incremento C). Los dos caminos por los que
/// un gerente entra al pipeline desde Cowork: `analysis` = spec de intake de un
/// prototipo nuevo (submit_prototype), `change_analysis` = mini-spec del delta
/// de una petición de cambio (request_change). La generación NO se encola
/// todavía (sigue por CLI: necesita toolchain de build y credenciales de git),
/// pero el enum admite ampliarlo sin rediseñar la cola.
enum AnalysisJobKind {
  analysis
  change_analysis

  @@map("analysis_job_kind")
}

enum AnalysisJobStatus {
  queued // esperando a que un worker lo tome
  running // tomado por un worker (ver workerId/heartbeatAt)
  success
  error

  @@map("analysis_job_status")
}

/// Un trabajo de análisis pendiente (D-047). Existe para que `submit_prototype`
/// y `request_change` NO tengan que esperar ~5 minutos dentro de una request
/// HTTP: la tool encola y devuelve al instante; un worker aparte
/// (`src/worker.ts`, servicio `factory-runner`) lo toma y corre el Agent SDK.
///
/// Separado de `Run` a propósito: `Run` es el registro de auditoría de UNA
/// ejecución del agente (coste, tokens, sesión) y debe seguir siéndolo. Un
/// trabajo puede morir antes de ejecutar nada, o reintentarse — mezclarlo con
/// la auditoría fue justo lo que produjo los "runs huérfanos" de D-030/D-046.
///
/// Toma atómica: `UPDATE ... WHERE id = (SELECT ... FOR UPDATE SKIP LOCKED
/// LIMIT 1)` — sin Redis ni broker externo. Un trabajo activo (queued|running)
/// por proyecto como mucho: la unicidad NO es un índice (Postgres la exigiría
/// parcial y Prisma no sabe declararlos, lo que dejaría drift en el schema),
/// se garantiza en `AnalysisJobsService.enqueue` con un lock de fila sobre el
/// proyecto (`SELECT ... FOR UPDATE`) dentro de la misma transacción.
model AnalysisJob {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind      AnalysisJobKind
  projectId String          @db.Uuid
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Obligatorio cuando kind = change_analysis; null en un análisis de intake.
  changeRequestId String?        @db.Uuid
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  status   AnalysisJobStatus @default(queued)
  /// Veces que un worker lo ha tomado. Sin reintento automático en D-047 (se
  /// evaluó y quedó fuera de alcance): sirve para ver de un vistazo si algo se
  /// reencoló a mano.
  attempts Int               @default(0)

  /// Quién lo pidió (email del actor de Cowork) — auditoría y mensajes.
  requestedBy String
  /// Identidad del proceso que lo tomó (host:pid), para diagnosticar.
  workerId    String?
  claimedAt   DateTime?
  /// Latido del worker mientras corre. Si se queda atrás, el barrido lo da por
  /// muerto: es lo que evita el "proyecto atascado en analyzing con un run
  /// huérfano" que hubo que sanear a mano por SQL en D-046.
  heartbeatAt DateTime?
  finishedAt  DateTime?

  /// Run que produjo la ejecución (se enlaza en cuanto el runner lo crea, para
  /// que el barrido sepa qué run cerrar si el proceso muere).
  runId        String? @db.Uuid
  errorMessage String? @db.Text

  @@index([status, createdAt])
  @@index([projectId])
  @@map("analysis_jobs")
}

/// Una versión de la spec intermedia (docs/04, paso 2). Nueva versión cada
/// vez que un gate pide "complementar" (docs/05) — nunca se edita in-place,
/// para conservar el historial completo de qué se aprobó.
model Spec {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int

  /// Markdown, mismo formato que docs/pipeline/<slug>/spec-funcional.md.
  functionalContent String @db.Text
  /// Markdown, mismo formato que docs/pipeline/<slug>/spec-tecnica.md.
  technicalContent  String @db.Text

  /// Score de complejidad (docs/05: nº de entidades, integraciones externas,
  /// lógica no trivial) — informa si el gate puede auto-aprobarse por
  /// muestreo o es obligatorio.
  complexityScore Int?
  /// Flags detectados por el análisis (docs/05: datos personales/RGPD,
  /// dependencia externa nueva, primer módulo de un tipo, migración a core).
  sensitivityFlags Json @default("[]")
  /// Qué resuelve el core o módulos existentes (antiduplicación, docs/04
  /// list_modules) — texto libre del análisis.
  reuseNotes String? @db.Text

  /// null = spec de intake original (prototipo nuevo). Con valor = mini-spec
  /// de un cambio incremental (request_change): describe solo el delta sobre
  /// el módulo vivo, no el módulo entero.
  changeRequestId String?        @db.Uuid
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  gates Gate[]
  runs  Run[]

  @@unique([projectId, version])
  @@map("specs")
}

enum GateType {
  functional // Aprueba el gerente (docs/05)
  technical // Aprueba el revisor técnico (docs/05)
  pr_review // Aprueba el revisor técnico sobre el PR generado (paso 6)
  manager_acceptance // Aprueba el gerente en staging (paso 8)

  @@map("gate_type")
}

enum GateStatus {
  pending
  approved
  rejected
  changes_requested // "Complementar" (docs/05): vuelve a spec_ready con nueva versión

  @@map("gate_status")
}

/// Un punto de aprobación humana. docs/05 da tres salidas al revisor:
/// aprobar / rechazar con motivo / complementar — `changes_requested` cubre
/// "complementar" (nunca se parchea código a mano, se regenera desde spec).
model Gate {
  id            String     @id @default(uuid(7)) @db.Uuid
  createdAt     DateTime   @default(now())
  specId        String     @db.Uuid
  spec          Spec       @relation(fields: [specId], references: [id], onDelete: Cascade)
  gateType      GateType
  status        GateStatus @default(pending)
  /// Email/nombre de quien decide. Sin FK a `core.users`: la Fábrica no
  /// comparte base de datos con la Plataforma (D-029) — en Fase 1 este campo
  /// es texto libre porque el único operador es Leonardo (D-021, doble rol).
  reviewer      String?
  decisionNotes String?    @db.Text
  decidedAt     DateTime?

  @@map("gates")
}

enum RunType {
  analysis // Paso 2: Agent SDK produce la spec funcional+técnica
  generation // Paso 4: Agent SDK escribe código en una rama del monorepo

  @@map("run_type")
}

enum RunStatus {
  pending
  running
  success
  error

  @@map("run_status")
}

/// Una ejecución del Agent SDK (headless, docs/03). `specId` nullable porque
/// un run de análisis crea la spec — no puede referenciarla de antemano.
model Run {
  id             String    @id @default(uuid(7)) @db.Uuid
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  projectId      String    @db.Uuid
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specId         String?   @db.Uuid
  spec           Spec?     @relation(fields: [specId], references: [id], onDelete: SetNull)
  runType        RunType
  status         RunStatus @default(pending)
  /// Rama `factory/<slug>` creada por un run de generación (docs/05: nunca
  /// escribe directo a main).
  branchName     String?
  prUrl          String?
  /// session_id del Agent SDK (trazabilidad, ver agent-sdk.client.ts).
  agentSessionId String?
  outputSummary  String?   @db.Text
  errorMessage   String?   @db.Text
  costUsd        Float?
  inputTokens    Int?
  outputTokens   Int?

  @@map("runs")
}
